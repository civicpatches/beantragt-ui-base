{
  "name": "beantragt",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "nuxt dev --host=0.0.0.0 --port=3000",
    "build": "nuxt build",
    "build:casework": "node scripts/check-casework-build.mjs",
    "check:layers": "node scripts/check-layer-boundary.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test:unit": "nuxt prepare && vitest run",
    "i18n:check": "node scripts/check-translations.js",
    "typecheck": "nuxt typecheck && pnpm run typecheck:server",
    "typecheck:server": "vue-tsc --noEmit --project .nuxt-casework/tsconfig.server.json"
  },
  "dependencies": {
    "@comark/nuxt": "^0.3.1",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "~4.11.1",
    "@nuxtjs/i18n": "~10.6.0",
    "exceljs": "^4.4.0",
    "h3": "^1.15.11",
    "htmlparser2": "12.0.0",
    "maplibre-gl": "~6.4.1",
    "nuxt": "~4.7.0",
    "pdfmake": "0.3.15",
    "saxes": "5.0.1",
    "tailwindcss": "~4.3.3",
    "vuedraggable": "4.1.0",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.118",
    "@nuxt/devtools": "3.4.4",
    "@nuxt/eslint": "~1.17.0",
    "@nuxt/eslint-config": "~1.17.0",
    "@types/pdfmake": "0.3.3",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/language-core": "~3.3.11",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "happy-dom": "^20.8.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.2",
    "vue": "~3.5.46",
    "vue-tsc": "~3.3.11"
  },
  "pnpm": {
    "overrides": {
      "undici@<6.29.1": "^6.29.1",
      "@nuxt/icon": "2.5.1"
    }
  },
  "license": "AGPL-3.0-only"
}
